{
  "schema": 1,
  "id": "pulse",
  "name": "Pulse",
  "author": "Panelith",
  "description": "Two minutes of CPU and GPU history as wide live graphs, load filled and temperature traced over it.",
  "canvas": { "width": 1920, "height": 480, "scaling": "fit", "background": "#04060a" },
  "background": { "color": "#04060a" },
  "defaults": { "fontFamily": "Inter", "color": "#e8eef6", "accentColor": "#3ee0c5", "trackColor": "#141b26" },
  "widgets": [
    { "type": "shape", "x": 24, "y": 20, "width": 924, "height": 400, "shape": "rectangle", "fill": "#0a0f17", "stroke": "#17202c", "strokeWidth": 1.5, "cornerRadius": 22 },
    { "type": "text", "stabilizeWidth": false, "x": 54, "y": 40, "width": 120, "height": 28, "text": "CPU", "fontSize": 20, "fontWeight": 700, "letterSpacing": 4, "color": "#3ee0c5" },
    { "type": "text", "stabilizeWidth": false, "x": 140, "y": 42, "width": 460, "height": 26, "text": "{@cpu.name}", "fontSize": 17, "color": "#5b6b7f" },
    { "type": "text", "stabilizeWidth": false, "x": 50, "y": 70, "width": 330, "height": 100, "text": "{@cpu.load:0}%", "fontSize": 92, "fontWeight": 700, "color": "#3ee0c5" },
    { "type": "text", "stabilizeWidth": false, "x": 560, "y": 64, "width": 360, "height": 60, "text": "{@cpu.temp:0}\u00B0C", "fontSize": 52, "fontWeight": 700, "align": "right",
      "colorBinding": "@cpu.temp", "colorStops": [ { "at": 0, "color": "#ffb35c" }, { "at": 80, "color": "#ff8a5c" }, { "at": 90, "color": "#ff5d73" } ] },
    { "type": "text", "stabilizeWidth": false, "x": 520, "y": 128, "width": 400, "height": 30, "text": "{@cpu.clock:clock}   \u00B7   {@cpu.power:0} W", "fontSize": 20, "align": "right", "color": "#8ea0b5" },
    { "type": "graph", "x": 44, "y": 186, "width": 884, "height": 214, "windowSeconds": 120, "minimum": 0, "maximum": 100, "gridColor": "#131a25", "gridDivisions": 4, "backgroundColor": "#00000000",
      "series": [
        { "value": "@cpu.load", "color": "#3ee0c5", "thickness": 3, "fill": true, "fillOpacity": 0.22 },
        { "value": "@cpu.temp", "color": "#ffb35c", "thickness": 2.5, "fill": false }
      ] },

    { "type": "shape", "x": 972, "y": 20, "width": 924, "height": 400, "shape": "rectangle", "fill": "#0a0f17", "stroke": "#17202c", "strokeWidth": 1.5, "cornerRadius": 22 },
    { "type": "text", "stabilizeWidth": false, "x": 1002, "y": 40, "width": 120, "height": 28, "text": "GPU", "fontSize": 20, "fontWeight": 700, "letterSpacing": 4, "color": "#7aa2ff" },
    { "type": "text", "stabilizeWidth": false, "x": 1088, "y": 42, "width": 460, "height": 26, "text": "{@gpu.name}", "fontSize": 17, "color": "#5b6b7f" },
    { "type": "text", "stabilizeWidth": false, "x": 998, "y": 70, "width": 330, "height": 100, "text": "{@gpu.load:0}%", "fontSize": 92, "fontWeight": 700, "color": "#7aa2ff" },
    { "type": "text", "stabilizeWidth": false, "x": 1508, "y": 64, "width": 360, "height": 60, "text": "{@gpu.temp:0}\u00B0C", "fontSize": 52, "fontWeight": 700, "align": "right",
      "colorBinding": "@gpu.temp", "colorStops": [ { "at": 0, "color": "#d29cff" }, { "at": 78, "color": "#ff8a5c" }, { "at": 88, "color": "#ff5d73" } ] },
    { "type": "text", "stabilizeWidth": false, "x": 1468, "y": 128, "width": 400, "height": 30, "text": "{@gpu.clock:clock}   \u00B7   {@gpu.power:0} W", "fontSize": 20, "align": "right", "color": "#8ea0b5" },
    { "type": "graph", "x": 992, "y": 186, "width": 884, "height": 214, "windowSeconds": 120, "minimum": 0, "maximum": 100, "gridColor": "#131a25", "gridDivisions": 4, "backgroundColor": "#00000000",
      "series": [
        { "value": "@gpu.load", "color": "#7aa2ff", "thickness": 3, "fill": true, "fillOpacity": 0.22 },
        { "value": "@gpu.temp", "color": "#d29cff", "thickness": 2.5, "fill": false }
      ] },

    { "type": "text", "stabilizeWidth": false, "x": 40, "y": 434, "width": 1840, "height": 32,
      "text": "RAM {@mem.used:bytes1} / {@mem.total:bytes0}      VRAM {@gpu.vram.used:bytes1} / {@gpu.vram.total:bytes0}      \u2193 {@net.down:rate}   \u2191 {@net.up:rate}      {@sys.time}",
      "fontSize": 21, "align": "center", "color": "#8ea0b5" }
  ]
}
