{
  "schema": 1,
  "id": "desk",
  "name": "Desk",
  "author": "Panelith",
  "description": "A calm workday board: time and date, three soft rings for CPU, memory and GPU, plus network, system drive space and uptime.",
  "canvas": { "width": 1920, "height": 480, "scaling": "fit", "background": "#0b0e13" },
  "background": { "color": "#0b0e13", "gradientTo": "#10161d", "gradientAngle": 90 },
  "defaults": { "fontFamily": "Segoe UI Variable Display", "color": "#e9eef4", "accentColor": "#6fb6ff", "trackColor": "#1a222c" },
  "widgets": [
    { "type": "text", "stabilizeWidth": false, "x": 60, "y": 60, "width": 560, "height": 190, "text": "{@sys.time}", "fontSize": 170, "fontWeight": 300, "verticalAlign": "middle", "letterSpacing": -3 },
    { "type": "text", "stabilizeWidth": false, "x": 66, "y": 262, "width": 560, "height": 50, "text": "{@sys.date}", "fontSize": 38, "color": "#8b97a6" },
    { "type": "text", "stabilizeWidth": false, "x": 66, "y": 330, "width": 560, "height": 32, "text": "{@sys.host}", "fontSize": 24, "color": "#4f5b69" },
    { "type": "text", "stabilizeWidth": false, "x": 66, "y": 366, "width": 560, "height": 32, "text": "up {@sys.uptime:duration}", "fontSize": 24, "color": "#4f5b69" },

    { "type": "shape", "x": 660, "y": 70, "width": 2, "height": 340, "shape": "rectangle", "fill": "#18202a" },

    { "type": "gauge", "x": 712, "y": 80, "width": 250, "height": 250, "value": "@cpu.load", "minimum": 0, "maximum": 100, "startAngle": 225, "sweepAngle": 270, "thickness": 16, "color": "#6fb6ff" },
    { "type": "text", "stabilizeWidth": false, "x": 712, "y": 160, "width": 250, "height": 80, "text": "{@cpu.load:0}%", "fontSize": 62, "fontWeight": 600, "align": "center", "verticalAlign": "middle" },
    { "type": "text", "stabilizeWidth": false, "x": 712, "y": 336, "width": 250, "height": 30, "text": "CPU", "fontSize": 22, "fontWeight": 600, "letterSpacing": 4, "align": "center", "color": "#6fb6ff" },
    { "type": "text", "stabilizeWidth": false, "x": 712, "y": 370, "width": 250, "height": 30, "text": "{@cpu.temp:0}\u00B0C", "fontSize": 22, "align": "center", "color": "#6b7786" },

    { "type": "gauge", "x": 1000, "y": 80, "width": 250, "height": 250, "value": "@mem.load", "minimum": 0, "maximum": 100, "startAngle": 225, "sweepAngle": 270, "thickness": 16, "color": "#b49cff" },
    { "type": "text", "stabilizeWidth": false, "x": 1000, "y": 160, "width": 250, "height": 80, "text": "{@mem.load:0}%", "fontSize": 62, "fontWeight": 600, "align": "center", "verticalAlign": "middle" },
    { "type": "text", "stabilizeWidth": false, "x": 1000, "y": 336, "width": 250, "height": 30, "text": "MEMORY", "fontSize": 22, "fontWeight": 600, "letterSpacing": 4, "align": "center", "color": "#b49cff" },
    { "type": "text", "stabilizeWidth": false, "x": 1000, "y": 370, "width": 250, "height": 30, "text": "{@mem.used:bytes1} of {@mem.total:bytes0}", "fontSize": 22, "align": "center", "color": "#6b7786" },

    { "type": "gauge", "x": 1288, "y": 80, "width": 250, "height": 250, "value": "@gpu.load", "minimum": 0, "maximum": 100, "startAngle": 225, "sweepAngle": 270, "thickness": 16, "color": "#7fdcb0" },
    { "type": "text", "stabilizeWidth": false, "x": 1288, "y": 160, "width": 250, "height": 80, "text": "{@gpu.load:0}%", "fontSize": 62, "fontWeight": 600, "align": "center", "verticalAlign": "middle" },
    { "type": "text", "stabilizeWidth": false, "x": 1288, "y": 336, "width": 250, "height": 30, "text": "GPU", "fontSize": 22, "fontWeight": 600, "letterSpacing": 4, "align": "center", "color": "#7fdcb0" },
    { "type": "text", "stabilizeWidth": false, "x": 1288, "y": 370, "width": 250, "height": 30, "text": "{@gpu.temp:0}\u00B0C", "fontSize": 22, "align": "center", "color": "#6b7786" },

    { "type": "shape", "x": 1584, "y": 70, "width": 2, "height": 340, "shape": "rectangle", "fill": "#18202a" },

    { "type": "text", "stabilizeWidth": false, "x": 1620, "y": 78, "width": 260, "height": 26, "text": "DOWNLOAD", "fontSize": 18, "fontWeight": 600, "letterSpacing": 3, "color": "#4f5b69" },
    { "type": "text", "stabilizeWidth": false, "x": 1620, "y": 104, "width": 260, "height": 44, "text": "{@net.down:rate}", "fontSize": 36, "fontWeight": 600 },
    { "type": "text", "stabilizeWidth": false, "x": 1620, "y": 162, "width": 260, "height": 26, "text": "UPLOAD", "fontSize": 18, "fontWeight": 600, "letterSpacing": 3, "color": "#4f5b69" },
    { "type": "text", "stabilizeWidth": false, "x": 1620, "y": 188, "width": 260, "height": 44, "text": "{@net.up:rate}", "fontSize": 36, "fontWeight": 600 },
    { "type": "text", "stabilizeWidth": false, "x": 1620, "y": 252, "width": 260, "height": 26, "text": "SYSTEM DRIVE", "fontSize": 18, "fontWeight": 600, "letterSpacing": 3, "color": "#4f5b69" },
    { "type": "text", "stabilizeWidth": false, "x": 1620, "y": 278, "width": 260, "height": 44, "text": "{@disk.free:bytes0} free", "fontSize": 36, "fontWeight": 600 },
    { "type": "bar", "x": 1620, "y": 332, "width": 250, "height": 6, "value": "@disk.used", "minimum": 0, "maximum": 100, "cornerRadius": 3, "color": "#6fb6ff" },
    { "type": "graph", "x": 1620, "y": 356, "width": 250, "height": 50, "windowSeconds": 120, "minimum": 0, "backgroundColor": "#00000000",
      "series": [ { "value": "@net.down", "color": "#6fb6ff", "thickness": 2, "fill": true, "fillOpacity": 0.14 } ] }
  ]
}
