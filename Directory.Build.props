<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata">
    <Product>Panelith</Product>
    <Company>Bharath Vadlamannati</Company>
    <Authors>Bharath Vadlamannati</Authors>
    <Copyright>Copyright (c) 2026 Bharath Vadlamannati</Copyright>
    <PackageLicenseExpression>PolyForm-Noncommercial-1.0.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/bharry29/panelith</PackageProjectUrl>
    <RepositoryUrl>https://github.com/bharry29/panelith</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <VersionPrefix>0.1.4</VersionPrefix>
  </PropertyGroup>

  <PropertyGroup Label="Dependencies">
    <!--
      Check every package, direct and transitive, against the advisory database on
      restore, and report even low-severity findings. These arrive as warnings
      rather than errors on purpose: a new advisory should not be able to break
      the build of a tagged commit that compiled fine yesterday. CI fails on them
      separately, so they still get noticed.
    -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>

    <!--
      Record the exact resolved version and hash of every dependency in a
      committed packages.lock.json, so a restore cannot quietly pick up something
      different from what was reviewed. See docs/building.md for how to update it
      after changing a package version.
    -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <!--
      Named so the lock files also cover the runtime-specific restore that
      build/publish.ps1 does for the self-contained release build. Without it the
      lock files would describe only a runtime-independent restore, and the
      release build would have to rewrite them.
    -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup Label="Determinism">
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
