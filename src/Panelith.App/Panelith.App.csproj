<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Panelith.App</RootNamespace>
    <AssemblyName>Panelith</AssemblyName>
    <Description>Panelith desktop app: pick a screen for your USB panel, watch it live, and see every sensor.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/panelith.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Panelith.Hosting/Panelith.Hosting.csproj" />
    <ProjectReference Include="../Panelith.Media/Panelith.Media.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Panelith.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <Content Include="../../themes/**/*" CopyToOutputDirectory="PreserveNewest" LinkBase="themes" />
    <!-- yt-dlp, QuickJS-ng and the PawnIO setup, fetched and hash-checked by build/fetch-tools.ps1. -->
    <Content Include="../../artifacts/tools/*.exe" CopyToOutputDirectory="PreserveNewest" LinkBase="tools" />
  </ItemGroup>

</Project>
