<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource BgBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>

  <!-- Type scale -->
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
  </Style>
  <Style Selector="TextBlock.faint">
    <Setter Property="Foreground" Value="{StaticResource FaintBrush}" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="1.4" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
  </Style>
  <Style Selector="TextBlock.metric">
    <Setter Property="FontSize" Value="34" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.mono, SelectableTextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- Surfaces -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="18" />
  </Style>
  <Style Selector="Border.banner">
    <Setter Property="Background" Value="{StaticResource WarnSoftBrush}" />
    <Setter Property="BorderBrush" Value="#55F0C14A" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16,12" />
  </Style>
  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
  </Style>

  <!-- Buttons -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="14,8" />
  </Style>
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="#04140F" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#6CF0DA" />
    <Setter Property="Foreground" Value="#04140F" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.thumb">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.thumb:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- Navigation rail -->
  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="Padding" Value="14,11" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected">
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
  </Style>

  <!-- Screen cards -->
  <Style Selector="Border.screen">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="Margin" Value="0,0,16,16" />
  </Style>
  <Style Selector="Border.screen.active">
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BoxShadow" Value="0 0 24 0 #403EE0C5" />
  </Style>

  <!-- Profile list -->
  <Style Selector="ListBox.profiles">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.profiles ListBoxItem">
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="ListBox.profiles ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
  </Style>
  <Style Selector="ListBox.profiles ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
  </Style>

  <!-- Colour and icon pickers -->
  <Style Selector="ListBox.swatches">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.swatches ListBoxItem">
    <Setter Property="Padding" Value="6" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MinWidth" Value="0" />
  </Style>
  <Style Selector="ListBox.swatches ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- Small icon-only buttons -->
  <Style Selector="Button.icon">
    <Setter Property="Padding" Value="5" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <!-- Pin toggle in the rail -->
  <Style Selector="ToggleButton.pin">
    <Setter Property="Padding" Value="6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Foreground" Value="{StaticResource FaintBrush}" />
  </Style>
  <Style Selector="ToggleButton.pin:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
  </Style>

  <!-- Day toggles in schedules -->
  <Style Selector="ToggleButton.day">
    <Setter Property="Padding" Value="9,5" />
    <Setter Property="Margin" Value="0,0,4,4" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="ToggleButton.day:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
  </Style>

  <!-- Sensor rows -->
  <Style Selector="Border.row">
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Border.row:pointerover">
    <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
  </Style>
</Styles>
