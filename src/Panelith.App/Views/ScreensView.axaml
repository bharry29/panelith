<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Panelith.App.ViewModels"
             xmlns:c="using:Panelith.App.Controls"
             x:Class="Panelith.App.Views.ScreensView"
             x:DataType="vm:ScreensViewModel">
  <ScrollViewer>
    <StackPanel Margin="28,22,12,28" Spacing="20">

      <DockPanel Margin="0,0,16,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Button Classes="accent" Click="NewVideoScreen" ToolTip.Tip="Make a screen that loops a video from this PC, cropped to the panel">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{x:Static vm:Icons.Play}" Width="14" Height="14" />
              <TextBlock Text="New video screen" />
            </StackPanel>
          </Button>
          <Button Classes="ghost" Command="{Binding ReloadCommand}" ToolTip.Tip="Reread every screen from disk after editing one">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{x:Static vm:Icons.Refresh}" Width="14" Height="14" />
              <TextBlock Text="Reload" />
            </StackPanel>
          </Button>
          <Button Classes="ghost" Click="OpenFolder" ToolTip.Tip="{Binding UserScreensFolder}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{x:Static vm:Icons.Folder}" Width="14" Height="14" />
              <TextBlock Text="My screens folder" />
            </StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Text="Screens" Classes="h1" />
          <TextBlock Classes="muted" Text="Click a screen to put it on the panel. The ticks and timer belong to the active profile. Thumbnails are live, drawn from this PC's sensors." TextWrapping="Wrap" />
        </StackPanel>
      </DockPanel>

      <!-- Rotation -->
      <Border Classes="card" Margin="0,0,16,0">
        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
          <ToggleSwitch Grid.Column="0" IsChecked="{Binding RotateScreens}" OnContent="" OffContent="" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Spacing="2" Margin="6,0,0,0" VerticalAlignment="Center">
            <TextBlock FontWeight="SemiBold">
              <Run Text="Rotate screens in " /><Run Text="{Binding ProfileName}" Foreground="{StaticResource AccentBrush}" />
            </TextBlock>
            <TextBlock Text="{Binding RotationSummary}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" IsEnabled="{Binding RotateScreens}">
            <TextBlock Text="Every" VerticalAlignment="Center" Classes="muted" />
            <NumericUpDown Value="{Binding RotationSeconds}" Minimum="5" Maximum="600" Increment="5" FormatString="0" Width="130" />
            <TextBlock Text="seconds" VerticalAlignment="Center" Classes="muted" />
          </StackPanel>
        </Grid>
      </Border>

      <ItemsControl ItemsSource="{Binding Cards}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="2" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ScreenCardViewModel">
            <Border Classes="screen" Classes.active="{Binding IsActive}">
              <StackPanel Spacing="12">
                <Button Classes="thumb"
                        Command="{Binding $parent[ItemsControl].((vm:ScreensViewModel)DataContext).ShowCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="Show on the panel">
                  <Border Background="#000000" CornerRadius="10" Padding="6">
                    <c:FrameView Frame="{Binding Thumbnail}" AspectRatio="{Binding AspectRatio}" Radius="5" />
                  </Border>
                </Button>
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <CheckBox Content="In rotation" IsChecked="{Binding InRotation}" IsEnabled="{Binding !HasProblem}" />
                    <Border Classes="pill" Background="{StaticResource AccentSoftBrush}" IsVisible="{Binding IsActive}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{x:Static vm:Icons.Check}" Width="12" Height="12" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="On panel" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                  <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Author}" Classes="faint" FontSize="12" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <TextBlock Text="{Binding Description}" Classes="muted" FontSize="12" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DockPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !HasProblem}">
                  <Button Classes="ghost small" Content="Wallpaper..." Click="SetWallpaper" Tag="{Binding}"
                          ToolTip.Tip="Put a picture or video behind this screen. Screens that come with Panelith are copied first." />
                  <Button Classes="ghost small" Content="Remove wallpaper" IsVisible="{Binding HasWallpaper}"
                          Command="{Binding $parent[ItemsControl].((vm:ScreensViewModel)DataContext).RemoveWallpaperCommand}" CommandParameter="{Binding}" />
                  <Button Classes="ghost small" Content="Delete" Click="DeleteScreen" Tag="{Binding}" IsVisible="{Binding IsUserTheme}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
