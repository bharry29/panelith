<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Panelith.App.ViewModels"
             xmlns:c="using:Panelith.App.Controls"
             x:Class="Panelith.App.Views.ScreensView"
             x:DataType="vm:ScreensViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="ScreenCard" x:DataType="vm:ScreenCardViewModel">
      <Border Classes="screen" Classes.active="{Binding IsActive}">
        <StackPanel Spacing="10">
          <Button Classes="thumb"
                  Command="{Binding $parent[ItemsControl].((vm:ScreensViewModel)DataContext).ShowCommand}"
                  CommandParameter="{Binding}"
                  ToolTip.Tip="Show on the panel"
                  AutomationProperties.Name="{Binding Name, StringFormat='Show {0} on the panel'}">
            <Border Background="#000000" CornerRadius="10" Padding="6">
              <c:FrameView Frame="{Binding Thumbnail}" AspectRatio="{Binding $parent[ItemsControl].((vm:ScreensViewModel)DataContext).ThumbnailAspect}" Radius="5" />
            </Border>
          </Button>
          <StackPanel Spacing="2" Margin="4,0">
            <DockPanel>
              <Border DockPanel.Dock="Right" Classes="pill" Background="{StaticResource AccentSoftBrush}" IsVisible="{Binding IsActive}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{x:Static vm:Icons.Check}" Width="12" Height="12" Foreground="{StaticResource AccentBrush}" />
                  <TextBlock Text="On panel" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                </StackPanel>
              </Border>
              <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Name}" />
            </DockPanel>
            <TextBlock Text="{Binding Description}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" MaxLines="1" ToolTip.Tip="{Binding Description}" />
          </StackPanel>
          <DockPanel Margin="4,0,0,0">
            <Button DockPanel.Dock="Right" Classes="icon" ToolTip.Tip="More" IsVisible="{Binding HasActions}" Width="30" Height="30"
                    AutomationProperties.Name="{Binding Name, StringFormat='More for {0}'}">
              <PathIcon Data="{x:Static vm:Icons.More}" Width="16" Height="16" />
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <MenuItem Header="Wallpaper..." Click="SetWallpaper" Tag="{Binding}" IsVisible="{Binding CanSetWallpaper}"
                            ToolTip.Tip="Put a picture or video behind this screen. Screens that come with Panelith are copied first." />
                  <MenuItem Header="Remove wallpaper" Click="RemoveWallpaper" Tag="{Binding}" IsVisible="{Binding HasWallpaper}" />
                  <MenuItem Header="Delete..." Click="DeleteScreen" Tag="{Binding}" IsVisible="{Binding IsUserTheme}" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <CheckBox Content="In rotation" IsChecked="{Binding InRotation}" IsEnabled="{Binding !HasProblem}" FontSize="13" />
          </DockPanel>
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer>
    <StackPanel Margin="28,22,12,28" Spacing="18">

      <DockPanel Margin="0,0,16,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Classes="accent" ToolTip.Tip="Make a screen that loops a video, cropped to the panel" AutomationProperties.Name="New video screen">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem Header="From a video on this PC..." Click="NewVideoScreen" />
                <MenuItem Header="From YouTube..." Click="NewYouTubeScreen" />
              </MenuFlyout>
            </Button.Flyout>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{x:Static vm:Icons.Video}" Width="14" Height="14" />
              <TextBlock Text="New video screen" />
              <PathIcon Data="{x:Static vm:Icons.Down}" Width="14" Height="14" Margin="2,0,-4,0" />
            </StackPanel>
          </Button>
          <Button Classes="ghost" ToolTip.Tip="More" Padding="9,8" AutomationProperties.Name="More screen actions">
            <PathIcon Data="{x:Static vm:Icons.More}" Width="16" Height="16" />
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem Header="Reload screens" Command="{Binding ReloadCommand}" ToolTip.Tip="Reread every screen from disk after editing one">
                  <MenuItem.Icon>
                    <PathIcon Data="{x:Static vm:Icons.Refresh}" Width="14" Height="14" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Open my screens folder" Click="OpenFolder">
                  <MenuItem.Icon>
                    <PathIcon Data="{x:Static vm:Icons.Folder}" Width="14" Height="14" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Open videos folder" Click="OpenVideosFolder" ToolTip.Tip="YouTube downloads and the loops made into screens">
                  <MenuItem.Icon>
                    <PathIcon Data="{x:Static vm:Icons.Video}" Width="14" Height="14" />
                  </MenuItem.Icon>
                </MenuItem>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Text="Screens" Classes="h1" />
          <TextBlock Classes="muted" Text="Click a screen to put it on the panel." TextWrapping="Wrap" />
        </StackPanel>
      </DockPanel>

      <!-- Rotation -->
      <Border Classes="card" Margin="0,0,16,0" Padding="16,12">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <ToggleSwitch Grid.Column="0" IsChecked="{Binding RotateScreens}" OnContent="" OffContent="" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Spacing="2" Margin="6,0,0,0" VerticalAlignment="Center">
            <TextBlock FontWeight="SemiBold">
              <Run Text="Rotate screens in " /><Run Text="{Binding ProfileName}" Foreground="{StaticResource AccentBrush}" />
            </TextBlock>
            <TextBlock Text="{Binding RotationSummary}" Classes="muted" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding RotateScreens}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" IsVisible="{Binding RotateScreens}">
            <TextBlock Text="Every" VerticalAlignment="Center" Classes="muted" />
            <NumericUpDown Value="{Binding RotationSeconds}" Minimum="5" Maximum="600" Increment="5" FormatString="0" Width="130" />
            <TextBlock Text="seconds" VerticalAlignment="Center" Classes="muted" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- My screens -->
      <StackPanel Spacing="10" IsVisible="{Binding HasUserCards}">
        <TextBlock Text="MY SCREENS" Classes="label" Margin="2,0,0,0" />
        <ItemsControl ItemsSource="{Binding UserCards}" ItemTemplate="{StaticResource ScreenCard}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="2" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </StackPanel>

      <!-- Included -->
      <StackPanel Spacing="10">
        <TextBlock Text="INCLUDED WITH PANELITH" Classes="label" Margin="2,0,0,0" />
        <ItemsControl ItemsSource="{Binding IncludedCards}" ItemTemplate="{StaticResource ScreenCard}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="2" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
