<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Panelith.App.ViewModels"
        xmlns:c="using:Panelith.App.Controls"
        x:Class="Panelith.App.Views.MediaImportWindow"
        x:DataType="vm:MediaImportViewModel"
        Title="{Binding Title}"
        Width="1100" Height="880" MinWidth="760" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <DockPanel Margin="24">

    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,16">
      <TextBlock Text="{Binding Title}" Classes="h1" />
      <TextBlock Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis">
        <Run Text="{Binding SourceName}" /><Run Text="  ·  " /><Run Text="{Binding SourceSizeText}" /><Run Text="  ·  for a " /><Run Text="{Binding PanelText}" /><Run Text=" panel" />
      </TextBlock>
    </StackPanel>

    <!-- Buttons -->
    <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsEditing}">
        <Button Content="Cancel" Command="{Binding CancelCommand}" />
        <Button Classes="accent" Command="{Binding CreateCommand}" Content="{Binding CreateLabel}" />
      </StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsReviewing}">
        <Button Content="Back to editing" Command="{Binding BackCommand}" ToolTip.Tip="Throws this version away so you can change the part, length or speed" />
        <Button Classes="accent" Content="Show on panel" Command="{Binding AcceptCommand}" />
      </StackPanel>
      <StackPanel Spacing="6" VerticalAlignment="Center" Margin="0,0,16,0">
        <ProgressBar Value="{Binding Progress}" IsIndeterminate="{Binding !ProgressKnown}" IsVisible="{Binding IsBusy}" Minimum="0" Maximum="100" />
        <TextBlock Text="{Binding Status}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Problem}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" IsVisible="{Binding Problem, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>
    </DockPanel>

    <Grid>
    <!-- Review: the finished screen, playing -->
    <ScrollViewer IsVisible="{Binding IsReviewing}">
      <StackPanel Spacing="16">
        <Border Background="#000000" CornerRadius="10" Padding="6">
          <c:FrameView Frame="{Binding ResultFrame}" AspectRatio="{Binding PanelAspect}" Radius="5" MaxHeight="420" />
        </Border>
        <Border Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Text="Saved on this PC" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto" RowSpacing="8">
              <TextBlock Text="Downloaded video" Classes="muted" IsVisible="{Binding DownloadedFile, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <SelectableTextBlock Grid.Column="1" Text="{Binding DownloadedFile}" TextWrapping="Wrap" FontSize="12"
                                   IsVisible="{Binding DownloadedFile, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <TextBlock Grid.Row="1" Text="Screen video" Classes="muted" IsVisible="{Binding ExportedFile, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ExportedFile}" TextWrapping="Wrap" FontSize="12"
                                   IsVisible="{Binding ExportedFile, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </Grid>
            <Button Classes="ghost" Content="Open the Panelith videos folder" Command="{Binding OpenVideosFolderCommand}" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <ScrollViewer IsVisible="{Binding IsEditing}">
      <StackPanel Spacing="14" IsEnabled="{Binding IsIdle}">

        <!-- Player: the whole picture with the crop, and what the panel will show -->
        <Border Classes="card" Padding="12">
          <StackPanel Spacing="10">
            <Border Background="#000000" CornerRadius="10" Padding="4">
              <c:CropBox Source="{Binding Preview}" Crop="{Binding Crop}" TargetAspect="{Binding PanelAspect}" MaxHeight="400" />
            </Border>
            <StackPanel Spacing="4">
              <TextBlock Text="ON THE PANEL" Classes="label" />
              <c:CroppedImage Source="{Binding Preview}" Crop="{Binding Crop}" AspectRatio="{Binding PanelAspect}" MaxHeight="120" HorizontalAlignment="Left" />
            </StackPanel>
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="ghost small" Content="Fit to the whole picture" Command="{Binding ResetCropCommand}" />
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" IsVisible="{Binding IsVideo}">
                <Button Classes="ghost icon" Command="{Binding TogglePlayCommand}" ToolTip.Tip="{Binding PlayTip}" AutomationProperties.Name="{Binding PlayTip}" Width="34" Height="34">
                  <PathIcon Data="{Binding PlayIcon}" Width="14" Height="14" />
                </Button>
                <TextBlock Text="{Binding PlayheadText}" Classes="mono" VerticalAlignment="Center" />
                <TextBlock Text="{Binding PreviewProgressText}" Classes="muted" FontSize="12" VerticalAlignment="Center"
                           IsVisible="{Binding PreviewProgressText, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </StackPanel>
            </DockPanel>
            <TextBlock Text="{Binding SoftWarning}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" FontSize="12"
                       IsVisible="{Binding SoftWarning, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </Border>

        <!-- Filmstrip: the part to loop -->
        <Border Classes="card" IsVisible="{Binding IsVideo}">
          <StackPanel Spacing="12">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="{Binding LengthText}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
              <TextBlock Text="Part to loop" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <c:Filmstrip Thumbnails="{Binding Thumbnails}" Duration="{Binding DurationSeconds}"
                         Start="{Binding StartSeconds}" End="{Binding EndSeconds}"
                         Playhead="{Binding PlayheadSeconds}" MaxLength="{Binding MaxLengthSeconds}"
                         Cursor="Hand" ToolTip.Tip="Drag the handles to choose where the loop starts and ends, or drag the middle to move it. Arrow keys nudge the last handle." />
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
              <TextBlock Text="Speed" Classes="muted" VerticalAlignment="Center" />
              <Slider Grid.Column="1" Minimum="0.25" Maximum="2" Value="{Binding Speed}" SmallChange="0.05" LargeChange="0.25" TickFrequency="0.25" IsSnapToTickEnabled="True" MaxWidth="320" HorizontalAlignment="Stretch" />
              <TextBlock Grid.Column="2" Text="{Binding SpeedText}" Width="40" VerticalAlignment="Center" />
              <CheckBox Grid.Column="3" IsChecked="{Binding SmoothLoop}" Content="Smooth loop" ToolTip.Tip="Blends the last half second into the start, so the loop has no jump" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- New screen -->
        <Border Classes="card" IsVisible="{Binding IsNewScreen}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="6">
              <TextBlock Text="Screen name" Classes="muted" FontSize="12" />
              <TextBox Text="{Binding Name}" MaxLength="60" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6">
              <TextBlock Text="On top of the video" Classes="muted" FontSize="12" />
              <ComboBox ItemsSource="{Binding OverlayChoices}" SelectedIndex="{Binding Overlay}" MinWidth="260" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- Wallpaper -->
        <Border Classes="card" IsVisible="{Binding IsWallpaper}">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
              <TextBlock Text="Darken" VerticalAlignment="Center" />
              <Slider Grid.Column="1" Minimum="0" Maximum="80" Value="{Binding ScrimPercent}" TickFrequency="5" IsSnapToTickEnabled="True" />
              <TextBlock Grid.Column="2" Text="{Binding ScrimPercent, StringFormat={}{0:0}%}" Width="40" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                       Text="Darker keeps the readings easy to see. Screens that come with Panelith are copied first, so the original stays as it was." />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
