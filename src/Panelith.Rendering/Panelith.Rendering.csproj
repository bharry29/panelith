<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Panelith.Rendering</RootNamespace>
    <Description>SkiaSharp theme renderer and image codec for Panelith.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Condition="'$(OS)' != 'Windows_NT'" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Panelith.Core/Panelith.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Fonts\*.ttf" />
    <EmbeddedResource Include="Fonts\OFL.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Panelith.Rendering.Tests" />
  </ItemGroup>

</Project>
